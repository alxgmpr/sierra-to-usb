	(text "100-ohm differential pairs; one AC-coupling capacitor per conductor at transmitter.\nSoC TX reaches NIC HSIP/HSIN; NIC HSOP/HSON reaches SoC RX.\nKeep PCIe controller quiescent before Ethernet power removal."
		(exclude_from_sim no)
		(at 25.4 233.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "959fb9c6-f8d5-5647-afe2-26f65bb97baf")
	)
	(text "Clock disconnected by default. Valid switched 3.3V after U1504 delay turns Q1601 on.\nMux stays on the SoC supply; NIC power cycling cannot turn on its clock path.\nCore reset delay ensures >100us clock-before-PERST margin. Validate shutdown transients."
		(exclude_from_sim no)
		(at 269.24 398.78 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "ac5be164-bc8b-5531-b499-9c84763261f8")
	)
	(text "RESET sinks: SoC U1601, supervisor Q303, core monitor U1505.\nNo push-pull outputs share ETH_PERST_N. CLKREQ and wake outputs use Ioff buffers.\nWhile NIC is off, firmware ignores asserted wake/CLKREQ and disables ASPM."
		(exclude_from_sim no)
		(at 208.28 289.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "f4b77958-9e21-59e3-8fc5-91e2cab9fb75")
	)

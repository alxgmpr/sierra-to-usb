	(text "VBUS senses cable presence only; it does not power the board.\n10k/16.5k divider: 2.718–3.293V at 4.4–5.25V, 1% resistor corners.\nUSB OTG ID floats: internal 1.8V pull-up selects device mode.\nPlace ESD at port; route DP/DM as a short 90-ohm pair.\nRecovery through Rockusb/MaskROM still requires device testing."
		(exclude_from_sim no)
		(at 30.48 320.04 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "15200b22-c2f8-5131-b513-009335d4b6b1")
	)
	(text "BOOT CONFIGURATION AND LOCAL I/O BYPASS"
		(exclude_from_sim no)
		(at 22.86 24.13 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "b05e999e-ebec-5a65-8bfb-4862e8b11291")
	)
	(text "POWERED-OFF-SAFE HEALTH AND DEBUG UART"
		(exclude_from_sim no)
		(at 302.26 161.29 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "b0dcc3bd-75ec-5037-9f82-90467b692d14")
	)
	(text "GPIO0_C4 (AN37), 3.3V PMUIO2: firmware health toggles.\nU1201 runs from always-on 3.3V; both sides default low.\nUART2_M0: 1V19 RX, 1U18 TX; buffers prevent back-power."
		(exclude_from_sim no)
		(at 307.34 332.74 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "b2a33589-9564-5b53-bdc2-ef58c63e9127")
	)
	(text "Configure TSADC_SHUT_M0 (1R20) active high.\nHardware overtemperature asserts RK_RESET_N via Q1201.\nCPU temperature thresholds and restart policy require qualification."
		(exclude_from_sim no)
		(at 381 381 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "c58c50e4-4a78-580d-91e0-88d750e1b596")
	)
	(text "One 100nF capacitor at every VCCIO ball:\n1D13, 1C13, 1F17, 1E16, 1N5/6, 1L4/5, 1N8.\nKeep unused peripherals disabled. Check domain voltages in DT."
		(exclude_from_sim no)
		(at 289.56 127 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "c697eebd-a6c5-552f-ada9-da336b8cc7c9")
	)
	(text "FLASH_VOL_SEL high selects 1.8V eMMC I/O.\nSDMMC0_DET high selects debug mux; no SD boot connector fitted."
		(exclude_from_sim no)
		(at 30.48 111.76 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)

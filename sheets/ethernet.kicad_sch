		(property "Footprint" "" (at 0 0 0) (hide yes) (effects (font (size 1.27 1.27))))
		(property "Datasheet" "https://www.belfuse.com/media/drawings/products/magjack%20ICMs/dr-mag-2250504.pdf" (at 0 0 0) (hide yes) (effects (font (size 1.27 1.27))))
		(property "Description" "Bel Fuse 2250504-1 (=Bel int. P/N 0826-1X1T-KH-F), 1x1 2.5GBASE-T 100W 4PPoE single-port MagJack ICM, THT tab-up, W/O LEDS. 16-pin + 4 shield legs (merged to 1 SH pin here) per Bel/TRP drawing C=2250504 Rev1 17APR2017. T1-T4/TRD+-/TRCT naming is Bel's own; MDI0-3 mapping to T1-T4 is a board-level assignment (Bel doc does not define it) -- see task-10-report.md. VC12/36/45/78 = PoE center taps, cable side, hot on all 4 pairs (4PPoE/Class8-style). NOTE: authoritative drawing shows NO LED pins for this exact P/N despite Bel's product-page metadata claiming LED:Yes -- see report." (at 0 0 0) (hide yes) (effects (font (size 1.27 1.27))))
		(property "ki_keywords" "magjack RJ45 2.5GBASE-T PoE ICM Bel" (at 0 0 0) (hide yes) (effects (font (size 1.27 1.27))))

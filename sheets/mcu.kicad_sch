				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "ef18133e-ce40-41c0-bcc2-e0f2792be525")
	)
	(text "J_FAN pinout: 1=+12V, 2=switched return (Q34 low-side, 2-wire fan; PWM'd via FAN_PWM, no separate PWM wire to fan). D26 flyback across the switched leg."
		(exclude_from_sim no)
		(at 345.44 77.47 0)

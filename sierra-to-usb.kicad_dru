(version 1)
# Custom Design Rules for sierra-to-usb (KiCad 10, JLCPCB JLC7628 4L 1.6mm stackup).
#
# Grammar reference: https://docs.kicad.org/10.0/en/pcbnew/pcbnew_advanced.html#custom_design_rules
# Syntax cross-checked against real-world JLCPCB rule sets (same grammar KiCad 8/9/10):
#   https://github.com/labtroll/KiCad-DesignRules
#   https://github.com/Cimos/KiCad-CustomDesignRules
#
# ---------------------------------------------------------------------------
# SECTION 1: Controlled-impedance geometry per net class (Task 15 step 2).
#
# Stackup: JLCPCB "JLC7628" / JLC04161H-7628, 4L, 1.6mm total.
#   L1 (sig) -- 7628 prepreg 0.2104mm, Er=4.4 (Nan Ya NP-155F 7628) -- In1 (GND)
#   In1 (GND) -- FR-4 core 1.065mm, Er=4.43 (Nan Ya NP-155F Core) -- In2 (PWR)
#   In2 (PWR) -- 7628 prepreg 0.2104mm, Er=4.4 -- L4 (sig)
#   Cu: L1/L4 1oz (0.035mm finished), In1/In2 0.5oz (0.0152mm finished)
# Source: https://jlcpcb.com/impedance (JLC7628 4-layer 1.6mm controlled-impedance
# stackup) and the JLCPCB-derived KiCad stackup template
# jlcpcb_4L_1.6mm_outer1oz_inner0.5oz_JLC04161H-7628.kicad_pcb from
# https://github.com/gsuberland/jlcpcb_autogenerated_stackups (auto-extracted
# from JLCPCB's own published per-material Er/thickness figures). See board
# text notes on Cmts.User and docs/ordering.md for the full derivation.
#
# All four controlled classes route on L1 (top), referenced to the In1 GND
# pour immediately below through the 0.2104mm/Er4.4 prepreg.
#
# GEOMETRY SOURCE (2026-07-16): JLCPCB's live impedance calculator
# (https://jlcpcb.com/pcb-impedance-calculator), stackup tab
# "JLC04161H-7628 (Standard/Finished thickness 1.59mm +/-10%)", 4L/1.6mm,
# outer 1oz / inner 0.5oz, L1 signal referenced to L2. These REPLACE the
# original Task-15 IPC-2141/quasi-static closed-form values. The three
# diff-pair widths moved <6% (0.24->0.2474, 0.27->0.2835, 0.19->0.1826),
# but the closed-form RF_50 CPWG width was WRONG by 2.4x (0.14 -> 0.3345):
# the quasi-static CPW model under-weighted the bottom-reference plane.
# This closes the "RF_50 re-derivation" order gate (docs/sourcing.md S5).
# JLCPCB fabs controlled-impedance boards to +/-10% against test coupons.
#
#   DIFF_USB_90  (USB2 D+/D-, USB3 SS_*):  W=0.2474mm gap=0.15mm -> 90 ohm diff
#     (USB_DBG_DP/DM deliberately EXCLUDED 2026-07-16: J3 debug is RP2040
#      native Full-Speed only — R78/R79 27.4R straight to pins 46/47, no HS
#      mux path — so it routes as Default class; the 90-ohm width/clearance
#      floors made the 0.5mm-pitch D25/A-row escapes unroutable for nothing)
#   DIFF_PCIE_85 (M.2 PCIe lanes/REFCLK):  W=0.2835mm gap=0.15mm -> 85 ohm diff
#   DIFF_MDI_100 (RTL8125 Ethernet MDI):   W=0.1826mm gap=0.15mm -> 100 ohm diff
#   RF_50 (CPWG, ANT*/GNSS):               W=0.3345mm ground-gap=0.30mm -> 50 ohm
#   Default (all uncontrolled signals):    W=0.3586mm -> 50 ohm single-ended
#     (user-requested 50-ohm target for normal signal traces; opt-width rule
#      below keeps the router at 0.3586mm while allowing short neck-downs
#      to the JLCPCB multilayer floor of 0.09mm for fine-pitch escapes)
#
# Clearance floor for all four classes to any other-net copper: 0.30mm. This
# equals the RF_50 CPWG's own designed ground-fill gap (the tightest genuine
# constraint) and gives the three diff-pair classes ~1.4x the reference-plane
# height as isolation margin from neighboring uncontrolled traces/pours.

(rule "Impedance: DIFF_USB_90 trace width"
	(layer outer)
	(condition "A.NetClass == 'DIFF_USB_90' && A.Type == 'Track'")
	(constraint track_width (min 0.2474mm) (opt 0.2474mm) (max 0.28mm))
)
(rule "Impedance: DIFF_USB_90 diff pair gap"
	(condition "A.NetClass == 'DIFF_USB_90'")
	(constraint diff_pair_gap (min 0.13mm) (opt 0.15mm) (max 0.17mm))
)
(rule "Impedance: DIFF_PCIE_85 trace width"
	(layer outer)
	(condition "A.NetClass == 'DIFF_PCIE_85' && A.Type == 'Track'")
	(constraint track_width (min 0.2835mm) (opt 0.2835mm) (max 0.31mm))
)
(rule "Impedance: DIFF_PCIE_85 diff pair gap"
	(condition "A.NetClass == 'DIFF_PCIE_85'")
	(constraint diff_pair_gap (min 0.13mm) (opt 0.15mm) (max 0.17mm))
)
(rule "Impedance: DIFF_MDI_100 trace width"
	(layer outer)
	(condition "A.NetClass == 'DIFF_MDI_100' && A.Type == 'Track'")
	(constraint track_width (min 0.1826mm) (opt 0.1826mm) (max 0.21mm))
)
(rule "Impedance: DIFF_MDI_100 diff pair gap"
	(condition "A.NetClass == 'DIFF_MDI_100'")
	(constraint diff_pair_gap (min 0.13mm) (opt 0.15mm) (max 0.17mm))
)
(rule "Impedance: RF_50 CPWG trace width"
	(layer outer)
	(condition "A.NetClass == 'RF_50' && A.Type == 'Track'")
	(constraint track_width (min 0.3345mm) (opt 0.3345mm) (max 0.36mm))
)
(rule "Impedance: RF_50 CPWG ground gap / clearance"
	(condition "A.NetClass == 'RF_50' && B.NetClass != 'RF_50'")
	(constraint clearance (min 0.30mm))
)

(rule "Impedance classes: clearance floor to other-net copper"
	(condition "(A.NetClass == 'DIFF_USB_90' || A.NetClass == 'DIFF_PCIE_85' || A.NetClass == 'DIFF_MDI_100') && B.NetClass != A.NetClass")
	(constraint clearance (min 0.30mm))
)
# General exemption: pad pairs of the SAME footprint get JLCPCB's SMD
# pad-to-pad capability (0.15mm) instead of netclass clearances. Package
# pin pitch is fixed by the part (RP2040 QFN 0.4mm, ESD arrays D20-D24,
# M.2 CN1 0.5mm fingers, MHF4 RF connectors, J8 magjack PoE taps, SIM
# contacts) and cannot honor the 0.30mm impedance floor or the 2.5mm
# POE_PRI netclass value; those exist to isolate routed copper and other
# parts, not a package from itself. Anything inside one footprint tighter
# than 0.15mm is a REAL JLCPCB etch/DFM concern and intentionally still
# errors. A.Reference resolves for pads (footprint children) -- the Task-15
# caveat about undefined Reference applies to tracks/vias/zones only, and
# both sides here are required to be pads. Defined BEFORE Section 2 so the
# PoE moat rules below still outrank it for cross-domain pairs ("last rule
# wins"); the T1/U20/U23/C19 barrier parts have their own later exemptions.
(rule "Same-footprint pad-pair clearance = JLCPCB pad-to-pad capability"
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Reference == B.Reference")
	(constraint clearance (min 0.15mm))
)

# ---------------------------------------------------------------------------
# SECTION 2: PoE primary-domain isolation moat (Task 15 step 4).
#
# POE_PRI_MOAT: every net in the PoE primary/hazardous-voltage domain must
# keep >=2.5mm copper-to-copper clearance from any copper NOT in that domain.
# This is enforced everywhere on the board via a NetClass condition -- it does
# not depend on the human router first placing/resizing the POE_PRI_MOAT
# rule-area zone (a placeholder for that area also exists in the PCB, see the
# "POE_PRI_MOAT" rule-area zone and its adjacent Cmts.User text note).
#
# POE_PRI membership (REWRITTEN 2026-07-16 — the Task-15 patterns were
# dead on arrival): KiCad netclass patterns match the FULL hierarchical
# net name, so "POE_*" never matched "/Power Input/POE_VDD54" and bare
# "N_AUX" never matched "/Power Input/N_AUX" — only the 4 global magjack
# tap nets were ever in the class, and the moat protected nothing else.
# The class is now populated with EXACT hierarchical names derived by a
# connectivity walk (BFS from the PoE input nets across every component,
# stopping at the barrier parts' secondary pins): 36 primary nets incl.
# 4 the Task-15 manual trace missed (N_CLAMP_D/G, N_AUX_R, N_R43C44),
# plus U10's unconnected-pad nets. POE_STS_RAW (secondary side of opto
# U23, despite the POE_ name) is deliberately NOT in the class. This
# membership is machine-verified by tools/check_netclasses.py (runs in
# the pre-commit hook): it re-derives the domain from the netlist and
# fails the commit on any drift, rename, or barrier breach.
#
# Rule shape (hardened, Task 15 fix pass -- see task-15-report.md "Fix pass"
# for the empirical 6-case matrix this is derived from): `A.Reference` only
# resolves for footprint children (pads). Tracks, vias, and zone fills have
# no Reference, so the old condition `A.Reference != B.Reference` never
# matched them and those pairs silently fell through to KiCad's netclass-level
# default clearance instead of this named rule -- and, worse, that same
# undefined-Reference gap meant the same-footprint exemption below NEVER
# actually suppressed the barrier-part case either (it also failed to match,
# so the netclass-level 2.5mm default fired anyway). Fixed by splitting into
# an unconditional moat rule plus narrow, later-defined (higher-priority)
# per-part exemptions keyed on courtyard membership instead of Reference.
# KiCad 10 custom-rule priority is "last rule defined for a matching
# condition wins" for a given constraint type, verified empirically by
# swapping rule order in the synthetic test board (see task-15-report.md).
(rule "POE_PRI_MOAT: primary-domain isolation >= 2.5mm"
	(condition "A.NetClass == 'POE_PRI' && B.NetClass != 'POE_PRI'")
	(constraint clearance (min 2.5mm))
)
# Exemption: T1 (transformer), U20/U23 (opto-isolators) and C19 (2kV Y-cap)
# are the schematic's documented barrier-crossing parts (see the isolation
# note on sheets/power_input.kicad_sch) -- their primary- and secondary-side
# pins sit on the SAME footprint, closer together than 2.5mm by the nature of
# an isolator package. That internal creepage/clearance is governed by the
# part's own safety rating (transformer 1500Vrms, opto isolation rating, Y-cap
# voltage rating), not by this board-level copper-spacing rule. Matched by
# courtyard membership (works for pads AND any track/via routed inside the
# barrier part's footprint) rather than Reference, and defined AFTER the
# general moat rule above so it wins for these specific pairs. These MUST
# stay below the general rule in file order -- see the priority note above.
(rule "POE_PRI_MOAT: T1 barrier exemption"
	(condition "A.insideCourtyard('T1') && B.insideCourtyard('T1')")
	(constraint clearance (min 0.2mm))
)
(rule "POE_PRI_MOAT: U20 barrier exemption"
	(condition "A.insideCourtyard('U20') && B.insideCourtyard('U20')")
	(constraint clearance (min 0.2mm))
)
(rule "POE_PRI_MOAT: U23 barrier exemption"
	(condition "A.insideCourtyard('U23') && B.insideCourtyard('U23')")
	(constraint clearance (min 0.2mm))
)
(rule "POE_PRI_MOAT: C19 barrier exemption"
	(condition "A.insideCourtyard('C19') && B.insideCourtyard('C19')")
	(constraint clearance (min 0.2mm))
)
# Note: same-domain POE_PRI/POE_PRI pad pairs inside one footprint (e.g. J8
# magjack POE_VA+ pin 13 next to POE_VB+ pin 15) are NOT matched by the moat
# rule above (it requires B outside the domain); they are governed by the
# general same-footprint pad-pair rule at the end of Section 1 (0.15mm =
# JLCPCB pad-to-pad capability). J8's Bel-drawing pads were shrunk 1.5->1.35
# (pins 13-16) and 1.7->1.55 / 2.4->2.3 (pin 1 / shield) to clear JLCPCB's
# 0.09mm etch floor -- drill sizes and positions untouched, annular >=0.15.

# ---------------------------------------------------------------------------
# SECTION 3: 50-ohm Default-class routing target + JLCPCB fab-capability
# rules (added 2026-07-16, verified against the live
# https://jlcpcb.com/capabilities/pcb-capabilities multilayer table and the
# JLCPCB impedance calculator; see docs/ordering.md).
#
# Default class = 50 ohm single-ended microstrip on L1/L4 (user request).
# The netclass width (0.3586mm, sierra-to-usb.kicad_pro) is what the router
# uses; this rule relaxes the DRC *minimum* to JLCPCB's multilayer floor so
# short neck-downs into fine-pitch pads (RP2040 QFN, TQFP ethernet PHY, M.2
# fingers) do not error. Impedance-critical nets belong in the four
# controlled classes above, never in Default.
(rule "Default class: 50 ohm opt width, fab-floor min"
	(condition "A.NetClass == 'Default' && A.Type == 'Track'")
	(constraint track_width (min 0.09mm) (opt 0.3586mm))
)

# JLCPCB PTH-specific limits that the single board-level knobs cannot
# express (board floors are set to the *via* limits in the project file;
# these rules layer the stricter plated-through-hole PAD limits on top).
# Numbers from the live capabilities page, multilayer column:
#   - hole to copper (any hole): >=0.20mm (board floor is 0.14 to allow the
#     scoped USB-C exemption at the end of this file; this rule restores
#     the real JLCPCB 0.2 requirement everywhere else)
#   - PTH annular ring: recommended >=0.20mm, absolute min 0.15mm (1oz)
#   - PTH hole to track: recommended 0.35mm, absolute min 0.28mm
#   - Pad hole to pad hole (different holes): >=0.45mm
# ORDER MATTERS: the generic hole-to-copper rule is defined FIRST so the
# stricter PTH-to-track rule below outranks it for PTH/track pairs.
(rule "JLCPCB: hole to copper >= 0.2mm"
	(constraint hole_clearance (min 0.2mm))
)
(rule "JLCPCB: PTH pad annular ring >= 0.15mm"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
	(constraint annular_width (min 0.15mm) (opt 0.2mm))
)
(rule "JLCPCB: PTH pad hole to track >= 0.28mm"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && B.Type == 'Track'")
	(constraint hole_clearance (min 0.28mm) (opt 0.35mm))
)
(rule "JLCPCB: PTH pad hole to hole >= 0.45mm"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && B.Type == 'Pad' && B.Pad_Type == 'Through-hole'")
	(constraint hole_to_hole (min 0.45mm))
)

# Exemptions for the JLCPCB PTH rules above: the HRO TYPE-C-31-M-04 USB-C
# receptacles (J1/J2/J3, LCSC C129018). Their THT B-row is 0.4mm drills on
# a 0.8mm staggered pitch with 0.6mm pads -- annular 0.10mm, hole-edge to
# hole-edge 0.40mm, and shield-pad copper to NPTH locating-peg hole down to
# 0.142mm. This is JLCPCB's own EasyEDA-verified land pattern for C129018
# (Task 14b pull, pad-for-pad reviewer-confirmed) for a connector JLCPCB
# assembles routinely; the geometry is dictated by the physical part and
# cannot meet the generic capability-page numbers. Accepted deviation,
# scoped to these three courtyards only. Defined LAST so they outrank the
# generic rules ("last rule wins").
(rule "JLCPCB exemption: USB-C J1/J2/J3 internal annular ring"
	(condition "A.insideCourtyard('J1') || A.insideCourtyard('J2') || A.insideCourtyard('J3')")
	(constraint annular_width (min 0.09mm))
)
(rule "JLCPCB exemption: USB-C J1/J2/J3 internal hole to hole"
	(condition "(A.insideCourtyard('J1') && B.insideCourtyard('J1')) || (A.insideCourtyard('J2') && B.insideCourtyard('J2')) || (A.insideCourtyard('J3') && B.insideCourtyard('J3'))")
	(constraint hole_to_hole (min 0.2mm))
)
(rule "JLCPCB exemption: USB-C J1/J2/J3 internal hole to copper"
	(condition "(A.insideCourtyard('J1') && B.insideCourtyard('J1')) || (A.insideCourtyard('J2') && B.insideCourtyard('J2')) || (A.insideCourtyard('J3') && B.insideCourtyard('J3'))")
	(constraint hole_clearance (min 0.14mm))
)
